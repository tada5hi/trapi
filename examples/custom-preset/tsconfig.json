{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "strict": false,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["src/**/*", "fixtures/**/*", "test/**/*"]
}
