{
    "extends": "@tada5hi/tsconfig",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",

        "experimentalDecorators": true,
        "verbatimModuleSyntax": false,

        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,

        "noEmit": true,
        "allowImportingTsExtensions": true,

        "types": ["node"],
        "skipLibCheck": true,
        "esModuleInterop": true,

        "strict": true,
        "noUncheckedIndexedAccess": false
    },
    "exclude": [
        "node_modules",
        "dist"
    ]
}
